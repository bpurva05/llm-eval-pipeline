# Required
OPENAI_API_KEY=sk-...

# Optional: Slack incoming webhook URL for alerts. If unset, alerts are skipped (not failed).
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional: override the model used for LLM-as-judge scoring (defaults to gpt-4o-mini)
JUDGE_MODEL=gpt-4o-mini

# Optional: pin which prompt version run_eval.py uses if --prompt-version isn't passed
PROMPT_VERSION=v2
